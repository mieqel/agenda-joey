  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.32",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "swr": "2.5.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "prisma": "5.22.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
